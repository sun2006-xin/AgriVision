# Required when binding System A/B outside loopback or running Compose.
# Use the same value for both services when System B calls System A /report.
AGRIVISION_API_TOKEN=replace-with-a-random-token-at-least-16-characters
AGRIVISION_API_AUTH_REQUIRED=true
# Optional override for System B -> System A calls when A uses a different token.
AGRIVISION_SYSTEM_A_API_TOKEN=

# Optional DingTalk-compatible Webhook settings. Never put credentials in source control.
AGRIVISION_ALERT_WEBHOOK_URL=
AGRIVISION_ALERT_WEBHOOK_SECRET=
AGRIVISION_WEBHOOK_ALLOWED_HOSTS=oapi.dingtalk.com

# Optional tuning with bounded defaults.
AGRIVISION_API_RATE_LIMIT_MAX=120
AGRIVISION_API_RATE_LIMIT_WINDOW=60
AGRIVISION_BIND_HOST=127.0.0.1
AGRIVISION_SYSTEM_A_BIND_HOST=127.0.0.1
